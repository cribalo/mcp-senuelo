{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-senuelo",
  "main": "src/index.ts",
  // Must be the account that holds the cribalo.com zone.
  "account_id": "de3e30eb20055289c56d92ef70aecdc9",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The only record is D1: Workers Logs would store IPs and bodies elsewhere.
  "observability": { "enabled": false },

  // Deploying with this block creates the DNS record for the custom domain (confirmed 8 Nov 2026).
  "routes": [{ "pattern": "mcp.cribalo.com", "zone_name": "cribalo.com", "custom_domain": true }],
  "workers_dev": false,

  // Static dashboard under /dash/; anything that is not a file falls through to the Worker.
  "assets": { "directory": "public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-senuelo",
      "database_id": "2c8d9c5b-3a23-4ed5-a0ac-c4ad7ca5dc3c",
      "migrations_dir": "migrations"
    }
  ],

  // Per hashed IP: 30 requests every 60 s.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  // Daily purge of rows older than RETENTION_DAYS.
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    "PUBLIC_HOSTNAME": "mcp.cribalo.com",
    "RETENTION_DAYS": "90",
    "MAX_BODY_BYTES": "32768",
    "MAX_FIELD_CHARS": "2000",
    "CONTACT": "contact@cribalo.com"
  }
  // Secrets (not here): IP_SALT, DASH_PASSWORD (>= 16 chars)  ->  `wrangler secret put ...`; locally in .dev.vars
}
